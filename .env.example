# Скопируйте в .env (он в .gitignore) и заполните при необходимости.
# Client ID веб-приложения из Google Cloud Console (OAuth 2.0). Можно перечислить несколько через запятую.
GOOGLE_CLIENT_IDS=
# Origin портала для CORS (пути /api/**, кроме /api/admin/**): точные значения через запятую, без wildcard.
# По умолчанию http://localhost:3000; в проде — https://qgames.site. Админку (3001) сюда не добавлять.
# CORS_ALLOWED_ORIGINS=
# Origin админ-панели для CORS (пути /api/admin/**): точные значения через запятую, без wildcard.
# По умолчанию http://localhost:3001; в проде — поддомен админки того же домена. Портал (3000) сюда не добавлять.
# ADMIN_CORS_ALLOWED_ORIGINS=
